@@ -0,0 +1,62 @@
+async page => {
+  const base = new URL(page.url()).origin;
+  const name = 'escape:map';
+  const assert = (ok, message) => { if (!ok) throw Error(message); };
+  const post = async (path, data) => {
+    const response = await page.request.post(base + path, {data:{...data, by:'test'}});
+    if (!response.ok()) throw Error(await response.text());
+    return response.json();
+  };
+  const open = async () => {
+    await post('/api/jellies/surface/call', {verb:'focus', args:{name}});
+    await page.locator('#full').waitFor({state:'visible'});
+    await page.waitForFunction(name => document.querySelector('#full iframe')?.contentWindow.jelly?.name === name, name);
+  };
+  const frame = () => page.frameLocator('#full iframe');
+  const startTrace = async scope => {
+    await scope.locator('#t-click').click();
+    await scope.locator('[data-step="1"]').click();
+    await scope.locator('[data-step="1"]').click();
+    await scope.getByText('Step 3 of', {exact:false}).waitFor();
+  };
+  const assertStep3 = async scope => assert((await scope.locator('.crumbs').textContent()).includes('Step 3 of'), 'trace step changed');
+  try {
+    await page.goto(`${base}/j/${name}/`);
+    await page.waitForFunction(() => window.jelly?.name === 'escape:map');
+    await startTrace(page);
+    await page.getByRole('button', {name:'Comment', exact:true}).click();
+    await page.evaluate(() => document.activeElement.blur());
+    await page.keyboard.press('Escape');
+    await page.getByRole('button', {name:'Comment', exact:true}).waitFor();
+    await assertStep3(page);
+
+    await page.getByRole('button', {name:'Comment', exact:true}).click();
+    await page.locator('#map [data-node]').first().click();
+    const editor = page.locator('.jf-pop textarea');
+    await editor.waitFor();
+    await editor.press('Escape');
+    await page.locator('.jf-pop').waitFor({state:'detached'});
+    await assertStep3(page);
+    await page.evaluate(() => document.activeElement.blur());
+    await page.keyboard.press('Escape');
+    await page.locator('.crumbs .chip').waitFor({state:'detached'});
+
+    await page.goto(`${base}/`);
+    await open();
+    const embedded = frame();
+    await startTrace(embedded);
+    await page.locator('#fcomment').click();
+    await page.waitForFunction(() => document.querySelector('#fcomment').classList.contains('on'));
+    await page.waitForTimeout(50);
+    await page.keyboard.press('Escape');
+    await page.waitForFunction(() => !document.querySelector('#fcomment').classList.contains('on'));
+    await page.locator('#full').waitFor({state:'visible'});
+    await assertStep3(embedded);
+    await embedded.locator('body').press('Escape');
+    await embedded.locator('.crumbs .chip').waitFor({state:'detached'});
+    console.log(JSON.stringify({passed:true, standalone:true, embedded:true, editorCancellation:true}));
+  } finally {
+    await page.goto('about:blank');
+    await page.request.delete(`${base}/api/jellies/${name}?by=test`);
+  }
+}
