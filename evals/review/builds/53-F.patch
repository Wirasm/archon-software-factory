+#[cfg(test)]
+mod escape_tests {
+    use super::*;
+    use std::future::IntoFuture as _;
+
+    /// Esc that ends comment mode must not also close the map's trace, standalone or
+    /// embedded. Runs the map recipe and the real runtime in Chrome against a live daemon.
+    #[tokio::test]
+    async fn escape_ends_commenting_without_closing_the_map_trace() {
+        let browser = chrome().expect("Chrome/Chromium required; set JELLY_CHROME to the browser binary");
+        let results = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let callback = format!("http://{}/result", results.local_addr().unwrap());
+        let (send, mut receive) = tokio::sync::mpsc::channel(1);
+        let receiver = tokio::spawn(axum::serve(results, Router::new().route("/result", post(move |body: String| async move {
+            send.send(serde_json::from_str::<Value>(&body).unwrap()).await.unwrap();
+            StatusCode::NO_CONTENT
+        }))).into_future());
+
+        let dir = tempfile::tempdir().unwrap();
+        let mut store = Store::open(dir.path()).unwrap();
+        let check = include_str!("../tests/fixtures/map-escape/check.js").replace("__TEST_RESULT__", &callback);
+        let view = include_str!("../skill/recipes/map/view.html").replace("</body>", &format!("<script>{check}</script></body>"));
+        let state = serde_json::from_str(include_str!("../skill/recipes/map/state.json")).unwrap();
+        store.create("test:map", view, include_str!("../skill/recipes/map/verbs.js").into(), state, "agent", false, "", "").unwrap();
+        let daemon = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let port = daemon.local_addr().unwrap().port();
+        let server = tokio::spawn(serve(store, daemon));
+
+        let mut chrome = tokio::process::Command::new(browser)
+            .args(["--headless=new", "--disable-gpu", "--no-first-run", "--no-default-browser-check", "--disable-component-update", "--window-size=1400,1000"])
+            .arg(format!("--user-data-dir={}", dir.path().join("chrome").display()))
+            .arg(format!("http://127.0.0.1:{port}/j/test:map/"))
+            .stdout(std::process::Stdio::null())
+            .stderr(std::process::Stdio::null())
+            .kill_on_drop(true).spawn().expect("browser could not start");
+        let result = tokio::time::timeout(std::time::Duration::from_secs(30), receive.recv()).await;
+        chrome.kill().await.expect("browser could not stop");
+        server.abort();
+        receiver.abort();
+        let result = result.expect("browser did not report within 30 seconds").expect("result channel closed");
+        assert_eq!(result["ok"], true, "{result:#}");
+    }
+}
