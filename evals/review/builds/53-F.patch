+# Map Escape browser check
+
+`cargo test` includes `server::escape_tests`, which needs Chrome/Chromium (set
+`JELLY_CHROME` if it is not in a usual location). It serves the map recipe from a
+temporary daemon with `tests/fixtures/map-escape/check.js` appended, and runs the
+check standalone and inside an iframe. Esc that ends comment mode must keep the
+trace step; Esc in the comment editor closes only the editor; Esc with comment
+mode off still leaves the trace, and embedded, still reaches the jelly page.
diff --git a/tests/fixtures/map-escape/check.js b/tests/fixtures/map-escape/check.js
new file mode 100644
index 0000000..e285f9c
--- /dev/null
+++ b/tests/fixtures/map-escape/check.js
@@ -0,0 +1,72 @@
+// Appended to the map recipe's view. The top window runs the check standalone,
+// then loads the same jelly in an iframe to run it embedded, and posts both results.
+(() => {
+  const embedded = window.parent !== window;
+  const tick = () => new Promise((r) => setTimeout(r, 30));
+  const escape = (el = document.body) => el.dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", bubbles: true, cancelable: true }));
+  const chip = () => document.querySelector("#panel .chip")?.textContent || null;
+  // Standalone, the runtime's Comment button shows the mode. Embedded, the jelly page
+  // owns that button and hears about the mode, and about Esc, over postMessage.
+  const heard = () => embedded ? parent.__heard : [];
+  const commenting = () => embedded
+    ? !!heard().filter((m) => m.type === "jelly:commenting").at(-1)?.on
+    : document.querySelector(".jf-btn").classList.contains("on");
+  const setCommenting = async (on) => {
+    if (embedded) window.postMessage({ type: "jelly:comment", on }, location.origin);
+    else if (commenting() !== on) document.querySelector(".jf-btn").click();
+    await tick();
+  };
+
+  async function check() {
+    const steps = [];
+    const expect = (what, ok, got) => steps.push({ what, ok: !!ok, got });
+    await tick();
+    document.querySelector(`#tools [data-trace="${jelly.state.traces[0].id}"]`).click();
+    document.querySelector('[data-step="1"]').click();
+    const atStep = chip();
+    expect("trace advanced past step one", atStep?.startsWith("Step 2 "), atStep);
+
+    await setCommenting(true);
+    expect("comment mode on", commenting(), commenting());
+    const escapesBefore = heard().filter((m) => m.type === "jelly:escape").length;
+    escape();
+    await tick();
+    expect("Esc ends comment mode", !commenting(), commenting());
+    expect("Esc that ends comment mode keeps the trace step", chip() === atStep, chip());
+    if (embedded) expect("Esc that ends comment mode stays in the jelly", heard().filter((m) => m.type === "jelly:escape").length === escapesBefore, heard());
+
+    await setCommenting(true);
+    document.querySelector("#title").click();
+    const ta = document.querySelector(".jf-pop textarea");
+    expect("clicking in comment mode opens the editor", ta, !!ta);
+    ta?.focus();
+    escape(ta);
+    await tick();
+    expect("Esc in the editor closes it", !document.querySelector(".jf-pop"), !!document.querySelector(".jf-pop"));
+    expect("Esc in the editor keeps the trace step", chip() === atStep, chip());
+
+    escape();
+    await tick();
+    expect("Esc with comment mode off leaves the trace", chip() === null, chip());
+    if (embedded) expect("Esc with comment mode off reaches the jelly page", heard().filter((m) => m.type === "jelly:escape").length === escapesBefore + 1, heard());
+    return steps;
+  }
+
+  addEventListener("load", async () => {
+    if (embedded) return parent.postMessage({ type: "map-escape", steps: await check().catch((e) => [{ what: String(e), ok: false }]) }, location.origin);
+    window.__heard = [];
+    let standalone;
+    addEventListener("message", (e) => {
+      if (e.data?.type?.startsWith("jelly:")) window.__heard.push(e.data);
+      if (e.data?.type !== "map-escape") return;
+      const result = { standalone, embedded: e.data.steps };
+      result.ok = [...standalone, ...e.data.steps].every((s) => s.ok) && standalone.length > 0 && e.data.steps.length > 0;
+      fetch("__TEST_RESULT__", { method: "POST", mode: "no-cors", body: JSON.stringify(result) });
+    });
+    standalone = await check().catch((e) => [{ what: String(e), ok: false }]);
+    const frame = document.createElement("iframe");
+    frame.style.cssText = "width:1280px;height:900px";
+    frame.src = location.href;
+    document.body.appendChild(frame);
+  });
+})();
