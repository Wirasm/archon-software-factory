+    /// Runs only as a child of `failed_archive_keeps_the_store_usable`, which
+    /// sets the env var and chooses where stderr goes.
+    #[test]
+    #[ignore]
+    fn failed_archive_child() {
+        if std::env::var_os("JELLY_SWEEP_CHILD").is_none() {
+            return;
+        }
+        let (_d, mut s) = store();
+        s.create("old", "".into(), VERBS.into(), json!({"labels": {}}), "agent", false, "", "").unwrap();
+        s.jellies.get_mut("old").unwrap().jelly.updated_ms = 0;
+        s.log_failure = Some((s.seq + 1, 0));
+        let store = std::sync::Mutex::new(s);
+        let swept = store.lock().unwrap().sweep(0);
+        assert!(swept.is_empty());
+        let s = store.lock().expect("store lock survives the failed archive");
+        assert!(!s.get("old").unwrap().archived);
+    }
+
+    #[test]
+    fn failed_archive_keeps_the_store_usable() {
+        let run = |stderr: std::process::Stdio| {
+            std::process::Command::new(std::env::current_exe().unwrap())
+                .args(["--exact", "store::tests::failed_archive_child", "--ignored", "--nocapture", "--test-threads=1"])
+                .env("JELLY_SWEEP_CHILD", "1")
+                .stdout(std::process::Stdio::null())
+                .stderr(stderr)
+                .output()
+                .unwrap()
+        };
+        let (reader, writer) = std::io::pipe().unwrap();
+        drop(reader);
+        let closed = run(writer.into());
+        assert!(closed.status.success(), "child panicked with closed stderr: {closed:?}");
+        let open = run(std::process::Stdio::piped());
+        assert!(open.status.success(), "{open:?}");
+        assert!(String::from_utf8_lossy(&open.stderr).contains("could not archive old: "), "{open:?}");
+    }
+
