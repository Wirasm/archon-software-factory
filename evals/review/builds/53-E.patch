+async page => {
+  // Esc that ends comment mode must not also reach the view: the map trace and its step stay put.
+  const base = new URL(page.url()).origin;
+  const name = 'escape:map';
+  const assert = (ok, message) => { if (!ok) throw Error(message); };
+  // The trace step shown in the crumbs, or null once the trace is gone.
+  const step = async doc => {
+    const chips = await doc.locator('.crumbs .chip').allTextContents();
+    return chips.map(t => t.match(/^Step (\d+) of /)?.[1]).find(Boolean) ?? null;
+  };
+  const walk = async doc => {
+    await doc.locator('#t-click').click();
+    await doc.locator('[data-step="1"]').click();
+    await doc.locator('[data-step="1"]').click();
+    assert(await step(doc) === '3', 'trace did not reach step 3');
+  };
+
+  // Standalone.
+  await page.goto(`${base}/j/${name}/`);
+  await page.waitForFunction(() => window.jelly?.state);
+  await walk(page);
+  const btn = page.locator('.jf-btn');
+  await btn.click();
+  await page.waitForFunction(() => document.querySelector('.jf-btn').textContent === 'Click a part to comment · Esc');
+  await page.evaluate(() => document.activeElement?.blur());
+  await page.keyboard.press('Escape');
+  await page.waitForFunction(() => document.querySelector('.jf-btn').textContent === 'Comment');
+  assert(await step(page) === '3', 'standalone: Esc that ended comment mode moved the trace');
+  await page.keyboard.press('Escape');
+  await page.locator('#tools [data-trace].on').waitFor({state:'detached'});
+  assert(await step(page) === null, 'standalone: second Esc did not leave the trace');
+
+  // The comment editor still cancels on Esc and leaves the trace alone.
+  await walk(page);
+  await btn.click();
+  await page.locator('#map .node').first().click();
+  await page.locator('.jf-pop textarea').waitFor();
+  await page.locator('.jf-pop textarea').press('Escape');
+  await page.locator('.jf-pop').waitFor({state:'detached'});
+  assert(await step(page) === '3', 'standalone: Esc in the comment editor moved the trace');
+
+  // Embedded in the jelly page's full view: focus lands in the iframe after the header's Comment.
+  await page.goto(`${base}/`);
+  await page.waitForFunction(() => window.jelly && typeof pendingFocusWrites === 'number' && pendingFocusWrites === 0);
+  const response = await page.request.post(`${base}/api/jellies/surface/call`, {data:{verb:'focus', args:{name}, by:'test'}});
+  assert(response.ok(), await response.text());
+  await page.locator('#full').waitFor({state:'visible'});
+  await page.waitForFunction(name => document.querySelector('#full iframe')?.contentWindow.jelly?.name === name, name);
+  const frame = page.frameLocator('#full iframe');
+  await walk(frame);
+  await page.locator('#fcomment').click();
+  // The header turns on before the iframe hears about it; a highlighted part proves the iframe is commenting.
+  await page.locator('#back').hover();
+  await frame.locator('#map .node').first().hover();
+  await page.waitForFunction(() => document.querySelector('#full iframe').contentDocument.querySelector('.jf-hover'));
+  await page.keyboard.press('Escape');
+  await page.waitForFunction(() => !document.querySelector('#fcomment').classList.contains('on'));
+  assert(await page.locator('#full').isVisible(), 'embedded: Esc that ended comment mode closed the full view');
+  assert(await step(frame) === '3', 'embedded: Esc that ended comment mode moved the trace');
+  await frame.locator('body').press('Escape');
+  await frame.locator('#tools [data-trace].on').waitFor({state:'detached'});
+  assert(await step(frame) === null, 'embedded: second Esc did not leave the trace');
+  return 'ok';
+}
