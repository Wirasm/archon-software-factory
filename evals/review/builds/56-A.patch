+/// True when the file at the log's path is no longer the one `reader` holds.
+#[cfg(unix)]
+fn history_replaced(reader: &BufReader<File>, store: &Store) -> bool {
+    use std::os::unix::fs::MetadataExt;
+    match (reader.get_ref().metadata(), std::fs::metadata(store.events_path())) {
+        (Ok(held), Ok(now)) => (held.dev(), held.ino()) != (now.dev(), now.ino()),
+        _ => false,
+    }
+}
+
+#[cfg(not(unix))]
+fn history_replaced(_: &BufReader<File>, _: &Store) -> bool { false }
