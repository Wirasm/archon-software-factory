+    #[test]
+    fn inbox_lost_history_is_refused_until_restored() {
+        for loss in ["moved", "emptied"] {
+            let (dir, mut s) = store();
+            s.create("sample", "".into(), VERBS.into(), json!({"labels": {}}), "agent", false, "", "p").unwrap();
+            let reader = || InboxReader::Named { name: "a".into() };
+            consume_inbox(&mut s, "p", reader()).unwrap();
+            let committed = s.sequence();
+            let unread = s.call("p:sample", "label", json!({"id": "a", "value": "x"}), PERSON).unwrap();
+            let readers = dir.path().join("inbox-readers.json");
+            let saved = fs::read(&readers).unwrap();
+            let aside = dir.path().join("aside.jsonl");
+            fs::copy(s.events_path(), &aside).unwrap();
+            if loss == "moved" { fs::remove_file(s.events_path()).unwrap() } else { fs::write(s.events_path(), "").unwrap() }
+
+            let err = s.call("p:sample", "label", json!({"id": "b", "value": "y"}), PERSON).unwrap_err();
+            assert!(err.to_string().contains("event history is missing"), "{loss}: {err}");
+            if loss == "moved" { assert!(!s.events_path().exists()) } else { assert_eq!(fs::read(s.events_path()).unwrap(), b"") }
+            assert!(s.get("p:sample").unwrap().state["labels"].get("b").is_none());
+
+            if loss == "moved" {
+                assert!(consume_inbox(&mut s, "p", reader()).is_err());
+            } else {
+                let batch = s.read_inbox("p", &reader()).unwrap();
+                assert!(batch.events.is_empty());
+                assert_eq!(batch.through, committed);
+                s.commit_inbox(InboxCommit { inbox: InboxRequest { project: "p".into(), reader: reader() }, through: batch.through }).unwrap();
+            }
+            assert_eq!(fs::read(&readers).unwrap(), saved, "{loss}");
+
+            fs::copy(&aside, s.events_path()).unwrap();
+            let seen = consume_inbox(&mut s, "p", reader()).unwrap();
+            assert_eq!(seen.iter().map(|e| e.seq).collect::<Vec<_>>(), [unread.seq], "{loss}");
+            let next = s.call("p:sample", "label", json!({"id": "b", "value": "y"}), PERSON).unwrap();
+            let seen = consume_inbox(&mut s, "p", reader()).unwrap();
+            assert_eq!(seen.iter().map(|e| e.seq).collect::<Vec<_>>(), [next.seq], "{loss}");
+            assert!(consume_inbox(&mut s, "p", reader()).unwrap().is_empty());
+        }
+    }
