+/// Reads on from where `history` stopped. A trim replaces the log file, so a
+/// stale reader is drained (it may hold unread events the trim dropped) and then
+/// reopened and read from the start; the filter in `recorded_change` makes the
+/// overlap harmless. Call with the store locked.
+fn next_record(store: &Store, history: &mut Option<History>, q: &WaitQ) -> Result<Option<Event>, Error> {
+    if let Some(h) = history {
+        if let Some(ev) = recorded_change(&mut h.reader, q)? { return Ok(Some(ev)); }
+        if h.generation == store.log_generation() { return Ok(None); }
+    }
+    *history = open_history(store)?;
+    match history {
+        Some(h) => recorded_change(&mut h.reader, q),
+        None => Ok(None),
+    }
+}
