+// Uses escape:map, installed from skill/recipes/map as described in tests/README.md.
+async page => {
+  const base = new URL(page.url()).origin;
+  const assert = (ok, message) => { if (!ok) throw Error(message); };
+  const failures = [];
+  await page.setViewportSize({width:1280, height:900});
+  for (const embedded of [false, true]) {
+    const label = embedded ? 'embedded' : 'standalone';
+    try {
+      await page.goto(`${base}${embedded ? '/' : '/j/escape:map/'}`);
+      if (embedded) {
+        await page.waitForFunction(() => window.jelly && pendingFocusWrites === 0);
+        const response = await page.request.post(`${base}/api/jellies/surface/call`, {
+          data:{verb:'focus', args:{name:'escape:map'}, by:'test'}
+        });
+        assert(response.ok(), await response.text());
+        await page.locator('#full').waitFor({state:'visible'});
+        await page.waitForFunction(() => document.querySelector('#full iframe')?.contentWindow.jelly?.name === 'escape:map');
+      }
+      const view = embedded ? page.frameLocator('#full iframe') : page;
+      const comment = embedded ? page.locator('#fcomment') : page.locator('.jf-btn');
+      const chip = view.locator('.crumbs .chip');
+      await view.locator('#t-click').click();
+      await view.locator('[data-step="1"]').click();
+      await view.locator('[data-step="1"]').click();
+      const step = await chip.textContent();
+      assert(/^Step 3 of \d+$/.test(step), `${label}: trace advanced to step 3`);
+      await comment.click();
+      // Hover confirms the iframe received comment mode before sending the key.
+      await view.locator('#n-runtime').hover();
+      await view.locator('#n-runtime.jf-hover, #n-runtime .jf-hover').waitFor({state:'visible'});
+      assert(await comment.textContent() === (embedded ? 'Click a part · Esc' : 'Click a part to comment · Esc'), `${label}: Comment advertises Escape`);
+      await view.locator('body').evaluate(() => document.activeElement.blur());
+      await page.keyboard.press('Escape');
+      await comment.filter({hasText:/^Comment$/}).waitFor({state:'visible'});
+      assert(await chip.count() === 1 && await chip.textContent() === step, `${label}: cancelling comment mode preserves trace step 3`);
+      if (embedded) assert(await page.locator('#full').isVisible(), 'embedded: cancelling comment mode preserves full view');
+
+      await comment.click();
+      await view.locator('#n-runtime').hover();
+      await view.locator('#n-runtime.jf-hover, #n-runtime .jf-hover').waitFor({state:'visible'});
+      await view.locator('#n-runtime').click();
+      await view.locator('.jf-pop textarea').press('Escape');
+      assert(await view.locator('.jf-pop').count() === 0, `${label}: Escape cancels the comment editor`);
+      assert(await chip.textContent() === step, `${label}: cancelling the editor preserves the step`);
+      if (embedded) assert(await page.locator('#full').isVisible(), 'embedded: cancelling the editor preserves full view');
+
+      // Keep evidence in the parent: ordinary iframe Escape may remove the frame.
+      await view.locator('body').evaluate(() => {
+        document.activeElement.blur();
+        document.addEventListener('keydown', e => {
+          if (e.key === 'Escape') window.parent.document.body.dataset.escapeTraceDismissed = String(!document.querySelector('.crumbs .chip'));
+        }, {once:true});
+      });
+      await page.keyboard.press('Escape');
+      await page.waitForFunction(() => document.body.dataset.escapeTraceDismissed === 'true');
+    } catch (error) {
+      failures.push(`${label}: ${error.message}`);
+    }
+  }
+  assert(failures.length === 0, failures.join('\n'));
+  return {passed:true, checked:['standalone', 'embedded', 'comment editor', 'ordinary Escape']};
+}
