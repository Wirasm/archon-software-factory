index 0000000..e332e1f
--- /dev/null
+++ b/tests/comment-escape.js
@@ -0,0 +1,58 @@
+async page => {
+  const base = new URL(page.url()).origin;
+  const name = 'escape:map';
+  const failures = [];
+  const assert = (ok, message) => { if (!ok) throw Error(message); };
+  const start = async view => {
+    await view.locator('#t-click').click();
+    await view.locator('[data-step="1"]').click();
+    await view.locator('[data-step="1"]').click();
+    assert((await view.locator('.crumbs .chip').textContent()).startsWith('Step 3 of '), 'trace starts at step 3');
+  };
+  const stepPreserved = async (view, label) => {
+    const chip = view.locator('.crumbs .chip');
+    assert(await chip.count() === 1 && (await chip.textContent()).startsWith('Step 3 of '), `${label}: Escape must preserve step 3`);
+  };
+  try {
+    await page.goto(`${base}/j/${name}/`);
+    await start(page);
+    await page.getByRole('button', {name:'Comment', exact:true}).click();
+    await page.getByRole('button', {name:'Click a part to comment · Esc', exact:true}).waitFor();
+    await page.evaluate(() => document.activeElement.blur());
+    await page.keyboard.press('Escape');
+    await page.getByRole('button', {name:'Comment', exact:true}).waitFor();
+    await stepPreserved(page, 'standalone');
+    await page.keyboard.press('Escape');
+    assert(await page.locator('.crumbs .chip').count() === 0, 'standalone: second Escape dismisses trace');
+
+    await start(page);
+    await page.getByRole('button', {name:'Comment', exact:true}).click();
+    await page.locator('.node').first().click();
+    await page.locator('.jf-pop textarea').press('Escape');
+    assert(await page.locator('.jf-pop').count() === 0, 'Escape closes comment editor');
+    await stepPreserved(page, 'comment editor');
+  } catch (e) { failures.push(e.message); }
+
+  try {
+    await page.goto(`${base}/`);
+    await page.waitForFunction(() => window.jelly && pendingFocusWrites === 0);
+    const response = await page.request.post(`${base}/api/jellies/surface/call`, {data:{verb:'focus', args:{name}, by:'test'}});
+    if (!response.ok()) throw Error(await response.text());
+    await page.locator('#full').waitFor({state:'visible'});
+    await page.waitForFunction(name => document.querySelector('#full iframe')?.contentWindow.jelly?.name === name, name);
+    const frame = page.frameLocator('#full iframe');
+    await start(frame);
+    await page.locator('#fcomment').click();
+    await frame.locator('.node').first().hover();
+    await page.waitForFunction(() => document.querySelector('#full iframe').contentDocument.querySelector('.jf-hover'));
+    await page.keyboard.press('Escape');
+    await page.waitForFunction(() => document.querySelector('#full').hidden || !document.querySelector('#fcomment').classList.contains('on'));
+    assert(await page.locator('#full').isVisible(), 'embedded: Escape must preserve the full view and step 3');
+    await stepPreserved(frame, 'embedded');
+    await page.keyboard.press('Escape');
+    // The existing embedded Escape may also close the full view.
+    await page.waitForFunction(() => document.querySelector('#full').hidden || !document.querySelector('#full iframe').contentDocument.querySelector('.crumbs .chip'));
+  } catch (e) { failures.push(e.message); }
+  if (failures.length) throw Error(failures.join('\n'));
+  return {passed:true};
+}
