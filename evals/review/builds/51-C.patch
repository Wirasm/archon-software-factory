+    #[test]
+    fn inbox_lost_history_is_refused_until_restored() {
+        for lose in ["moved", "emptied"] {
+            let (dir, mut s) = store();
+            s.create("sample", "".into(), VERBS.into(), json!({"labels": {}}), "agent", false, "", "p").unwrap();
+            let reader = InboxReader::Named { name: "a".into() };
+            consume_inbox(&mut s, "p", reader.clone()).unwrap();
+            let unread =s.call("p:sample", "label", json!({"id": "a", "value": "x"}), PERSON).unwrap();
+            let path = s.events_path();
+            let history = fs::read(&path).unwrap();
+            let cursors = fs::read(dir.path().join("inbox-readers.json")).unwrap();
+            fs::write(dir.path().join("aside.jsonl"), &history).unwrap();
+            if lose == "moved" {
+                fs::remove_file(&path).unwrap();
+            } else {
+                fs::write(&path, "").unwrap();
+            }
+
+            let error = s.call("p:sample", "label", json!({"id": "b", "value": "y"}), PERSON).unwrap_err();
+            assert!(error.to_string().contains("event history is missing"), "{lose}: {error}");
+            assert!(s.get("p:sample").unwrap().state.pointer("/labels/b").is_none());
+            if lose == "moved" {
+                assert!(!path.exists());
+            } else {
+                assert!(fs::read(&path).unwrap().is_empty());
+            }
+
+            let error = s.read_inbox("p", &reader).err().unwrap();
+            assert!(error.to_string().contains("event history is missing"), "{lose}: {error}");
+            assert_eq!(fs::read(dir.path().join("inbox-readers.json")).unwrap(), cursors);
+
+            fs::write(&path, &history).unwrap();
+            assert_eq!(consume_inbox(&mut s, "p", reader.clone()).unwrap().iter().map(|e| e.seq).collect::<Vec<_>>(), [unread.seq]);
+            let next = s.call("p:sample", "label", json!({"id": "c", "value": "z"}), PERSON).unwrap();
+            assert!(next.seq > unread.seq);
+            assert_eq!(consume_inbox(&mut s, "p", reader.clone()).unwrap().iter().map(|e| e.seq).collect::<Vec<_>>(), [next.seq]);
+            assert!(consume_inbox(&mut s, "p", reader).unwrap().is_empty());
+        }
+    }
