+<!doctype html>
+<meta charset="utf-8">
+<title>Map Escape check</title>
+<script>
+  // Loads the real map recipe under the real runtime, with no daemon.
+  (async () => {
+    const [view, state] = await Promise.all([
+      fetch('../skill/recipes/map/view.html').then((r) => r.text()),
+      fetch('../skill/recipes/map/state.json').then((r) => r.json()),
+    ]);
+    const boot = JSON.stringify({ name: 'test:map-escape', state, version: 1, viewRev: 1 }).replace(/</g, '\\u003c');
+    document.open();
+    document.write(`<script>window.__JELLY__ = ${boot};
+      window.WebSocket = class {};
+      window.fetch = async () => ({ ok: true, json: async () => ({}) });<\/script>
+      <script src="../assets/runtime.js"><\/script>` + view);
+    document.close();
+  })();
+</script>
