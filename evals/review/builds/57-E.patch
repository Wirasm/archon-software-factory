+    /// A failed archive warns on stderr; with stderr closed that write must not panic
+    /// (the sweeper holds the store lock). Runs the check in a child with a closed stderr pipe.
+    #[test]
+    fn failed_archive_with_closed_stderr_does_not_panic() {
+        const TEST: &str = "store::tests::failed_archive_with_closed_stderr_does_not_panic";
+        if std::env::var_os("JELLY_SWEEP_CHILD").is_some() {
+            let (_d, mut s) = store();
+            s.create("old", "".into(), VERBS.into(), json!({}), "agent", false, "", "").unwrap();
+            fs::remove_file(s.events_path()).unwrap();
+            fs::create_dir(s.events_path()).unwrap();
+            assert!(s.sweep(0).is_empty());
+            return;
+        }
+        let mut child = std::process::Command::new(std::env::current_exe().unwrap())
+            .args([TEST, "--exact", "--nocapture"])
+            .env("JELLY_SWEEP_CHILD", "1")
+            .stdout(std::process::Stdio::null())
+            .stderr(std::process::Stdio::piped())
+            .spawn()
+            .unwrap();
+        drop(child.stderr.take());
+        assert!(child.wait().unwrap().success(), "sweep panicked with stderr closed");
+    }
