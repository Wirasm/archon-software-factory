+    #[test]
+    fn removed_event_log_is_not_recreated_past_unread_events() {
+        // A fresh home creates the log on its first event and delivers normally.
+        let (dir, mut s) = store();
+        s.create("sample", "".into(), VERBS.into(), json!({"labels": {}}), "agent", false, "", "p").unwrap();
+        let reader = InboxReader::Named { name: "agent".into() };
+        assert!(consume_inbox(&mut s, "p", reader.clone()).unwrap().is_empty());
+        let unread = s.call("p:sample", "label", json!({"id": "a", "value": "x"}), PERSON).unwrap();
+        let cursors = dir.path().join("inbox-readers.json");
+        let committed = fs::read(&cursors).unwrap();
+
+        let aside = dir.path().join("events.aside");
+        fs::rename(s.events_path(), &aside).unwrap();
+        let error = s.call("p:sample", "label", json!({"id": "b", "value": "y"}), "agent").unwrap_err();
+        assert!(error.to_string().contains("event log is missing"), "{error}");
+        assert!(!s.events_path().exists());
+        assert_eq!(s.get("p:sample").unwrap().state, json!({"labels": {"a": "x"}}));
+        assert!(consume_inbox(&mut s, "p", reader.clone()).unwrap().is_empty());
+        assert_eq!(fs::read(&cursors).unwrap(), committed);
+
+        fs::rename(&aside, s.events_path()).unwrap();
+        assert_eq!(consume_inbox(&mut s, "p", reader.clone()).unwrap().iter().map(|e| e.seq).collect::<Vec<_>>(), [unread.seq]);
+        let next = s.call("p:sample", "label", json!({"id": "b", "value": "y"}), PERSON).unwrap();
+        assert_eq!(consume_inbox(&mut s, "p", reader.clone()).unwrap().iter().map(|e| e.seq).collect::<Vec<_>>(), [next.seq]);
+        assert!(consume_inbox(&mut s, "p", reader).unwrap().is_empty());
+    }
