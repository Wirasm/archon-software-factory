+    #[test]
+    fn inbox_lost_history_is_refused_until_restored() {
+        for loss in ["moved", "emptied"] {
+            let (dir, mut s) = store();
+            s.create("sample", "".into(), VERBS.into(), json!({"labels": {}}), "agent", false, "", "p").unwrap();
+            let reader = InboxReader::Named { name: "a".into() };
+            consume_inbox(&mut s, "p", reader.clone()).unwrap();
+            let committed = s.sequence();
+            let unread = s.call("p:sample", "label", json!({"id": "a", "value": "x"}), PERSON).unwrap();
+            let cursors = dir.path().join("inbox-readers.json");
+            let saved_cursors = fs::read(&cursors).unwrap();
+            let log = s.events_path();
+            let aside = dir.path().join("aside.jsonl");
+            if loss == "moved" {
+                fs::rename(&log, &aside).unwrap();
+            } else {
+                fs::copy(&log, &aside).unwrap();
+                fs::write(&log, "").unwrap();
+            }
+
+            let error = s.call("p:sample", "label", json!({"id": "b", "value": "y"}), PERSON).unwrap_err();
+            assert!(error.to_string().contains("event history is missing"), "{loss}: {error}");
+            if loss == "moved" {
+                assert!(!log.exists());
+            } else {
+                assert!(fs::read(&log).unwrap().is_empty());
+            }
+            assert!(s.get("p:sample").unwrap().state["labels"].get("b").is_none());
+
+            if loss == "moved" {
+                assert!(consume_inbox(&mut s, "p", reader.clone()).is_err());
+            } else {
+                let batch = s.read_inbox("p", &reader).unwrap();
+                assert!(batch.events.is_empty());
+                assert_eq!(batch.through, committed);
+                s.commit_inbox(InboxCommit { inbox: InboxRequest { project: "p".into(), reader: reader.clone() }, through: batch.through }).unwrap();
+            }
+            assert_eq!(fs::read(&cursors).unwrap(), saved_cursors, "{loss}");
+
+            fs::rename(&aside, &log).unwrap();
+            assert_eq!(consume_inbox(&mut s, "p", reader.clone()).unwrap().iter().map(|e| e.seq).collect::<Vec<_>>(), [unread.seq]);
+            let next = s.call("p:sample", "label", json!({"id": "c", "value": "z"}), PERSON).unwrap();
+            assert_eq!(consume_inbox(&mut s, "p", reader.clone()).unwrap().iter().map(|e| e.seq).collect::<Vec<_>>(), [next.seq]);
+            assert!(consume_inbox(&mut s, "p", reader).unwrap().is_empty());
+        }
+    }
