diff --git a/tests/sweep.rs b/tests/sweep.rs
new file mode 100644
index 0000000..8d7ed4d
--- /dev/null
+++ b/tests/sweep.rs
@@ -0,0 +1,142 @@
+use serde_json::{json, Value};
+use std::net::TcpListener;
+use std::process::{Child, Command, Stdio};
+use std::time::{Duration, Instant};
+
+const LIMIT: Duration = Duration::from_secs(10);
+
+struct Daemon(Child);
+
+impl Drop for Daemon {
+    fn drop(&mut self) {
+        let _ = self.0.kill();
+        let _ = self.0.wait();
+    }
+}
+
+fn closed_pipe() -> Stdio {
+    let (reader, writer) = std::io::pipe().unwrap();
+    drop(reader);
+    writer.into()
+}
+
+/// Starts a daemon on a free port and waits until it answers requests.
+fn start(home: &std::path::Path, stderr: Stdio) -> (Daemon, String) {
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let port = listener.local_addr().unwrap().port();
+    drop(listener);
+    let mut daemon = Daemon(
+        Command::new(env!("CARGO_BIN_EXE_jelly"))
+            .args(["serve", "--port", &port.to_string(), "--home"])
+            .arg(home)
+            .stdout(Stdio::null())
+            .stderr(stderr)
+            .spawn()
+            .unwrap(),
+    );
+    let url = format!("http://127.0.0.1:{port}");
+    let agent = ureq::AgentBuilder::new().timeout(LIMIT).build();
+    let deadline = Instant::now() + LIMIT;
+    loop {
+        if agent.get(&format!("{url}/api/jellies")).call().is_ok() {
+            break;
+        }
+        assert!(
+            daemon.0.try_wait().unwrap().is_none(),
+            "daemon exited during startup"
+        );
+        assert!(Instant::now() < deadline, "daemon did not start");
+        std::thread::sleep(Duration::from_millis(20));
+    }
+    (daemon, url)
+}
+
+fn sweep_failure(closed_stderr: bool) {
+    let home = tempfile::tempdir().unwrap();
+    let jellies = home.path().join("jellies");
+    let warnings = home.path().join("stderr.txt");
+    let agent = ureq::AgentBuilder::new().timeout(LIMIT).build();
+
+    // A jelly that the startup sweep will try to archive.
+    let (daemon, url) = start(home.path(), Stdio::null());
+    agent
+        .post(&format!("{url}/api/jellies"))
+        .send_json(json!({
+            "name": "old", "project": "test", "view": "<p>old</p>",
+            "verbs": "const verbs = {increment(s) { s.count += 1; }};",
+            "state": {"count": 0}, "by": "test"
+        }))
+        .unwrap();
+    drop(daemon);
+
+    let path = jellies.join("test:old.json");
+    let mut saved: Value = serde_json::from_slice(&std::fs::read(&path).unwrap()).unwrap();
+    saved["jelly"]["updated_ms"] = json!(0);
+    std::fs::write(&path, serde_json::to_vec(&saved).unwrap()).unwrap();
+    // The save writes `test:old.json.tmp` first, so a directory there makes archiving fail.
+    std::fs::create_dir(jellies.join("test:old.json.tmp")).unwrap();
+
+    let stderr = if closed_stderr {
+        closed_pipe()
+    } else {
+        std::fs::File::create(&warnings).unwrap().into()
+    };
+    let (mut daemon, url) = start(home.path(), stderr);
+
+    let listed: Value = agent
+        .get(&format!("{url}/api/jellies"))
+        .call()
+        .unwrap()
+        .into_json()
+        .unwrap();
+    assert_eq!(listed[0]["name"], "test:old");
+    assert_eq!(listed[0]["archived"], false);
+
+    if closed_stderr {
+        // The sweep has no observable output here, so give it time to run.
+        std::thread::sleep(Duration::from_millis(500));
+    } else {
+        let deadline = Instant::now() + LIMIT;
+        while !std::fs::read_to_string(&warnings)
+            .unwrap_or_default()
+            .contains("could not archive test:old: ")
+        {
+            assert!(Instant::now() < deadline, "sweep did not warn");
+            std::thread::sleep(Duration::from_millis(20));
+        }
+    }
+
+    // Every save uses the same temp path, so clear the blocker before the call saves.
+    std::fs::remove_dir(jellies.join("test:old.json.tmp")).unwrap();
+    // A verb call takes the store lock. A poisoned lock fails this request.
+    let call: Value = agent
+        .post(&format!("{url}/api/jellies/test:old/call"))
+        .send_json(json!({"verb": "increment", "args": {}, "by": "test"}))
+        .unwrap()
+        .into_json()
+        .unwrap();
+    assert_eq!(call["state"], json!({"count": 1}));
+    let listed: Value = agent
+        .get(&format!("{url}/api/jellies"))
+        .call()
+        .unwrap()
+        .into_json()
+        .unwrap();
+    assert_eq!(listed[0]["name"], "test:old");
+    assert!(daemon.0.try_wait().unwrap().is_none());
+    if !closed_stderr {
+        assert!(std::fs::read_to_string(warnings)
+            .unwrap()
+            .contains("could not archive test:old: "));
+    }
+}
+
+#[test]
+fn archive_failure_with_closed_stderr_keeps_store_usable() {
+    sweep_failure(true);
+}
+
+#[test]
+fn archive_failure_with_writable_stderr_still_warns() {
+    sweep_failure(false);
+}
