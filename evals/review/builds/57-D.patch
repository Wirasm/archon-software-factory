diff --git a/tests/sweep.rs b/tests/sweep.rs
new file mode 100644
index 0000000..a24d215
--- /dev/null
+++ b/tests/sweep.rs
@@ -0,0 +1,143 @@
+use serde_json::{json, Value};
+use std::net::TcpListener;
+use std::path::Path;
+use std::process::{Child, Command, Stdio};
+use std::time::{Duration, Instant};
+
+const LIMIT: Duration = Duration::from_secs(10);
+
+struct Daemon(Child);
+
+impl Drop for Daemon {
+    fn drop(&mut self) {
+        let _ = self.0.kill();
+        let _ = self.0.wait();
+    }
+}
+
+fn start(home: &Path, stderr: Stdio) -> (Daemon, String) {
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let port = listener.local_addr().unwrap().port();
+    drop(listener);
+    let daemon = Daemon(
+        Command::new(env!("CARGO_BIN_EXE_jelly"))
+            .args(["serve", "--port", &port.to_string(), "--home"])
+            .arg(home)
+            .stdout(Stdio::null())
+            .stderr(stderr)
+            .spawn()
+            .unwrap(),
+    );
+    (daemon, format!("http://127.0.0.1:{port}"))
+}
+
+fn wait_ready(daemon: &mut Daemon, agent: &ureq::Agent, url: &str) {
+    let deadline = Instant::now() + LIMIT;
+    loop {
+        assert!(daemon.0.try_wait().unwrap().is_none(), "daemon exited");
+        if agent.get(&format!("{url}/api/jellies")).call().is_ok() {
+            return;
+        }
+        assert!(Instant::now() < deadline, "daemon did not start");
+        std::thread::sleep(Duration::from_millis(20));
+    }
+}
+
+fn sweep_failure(closed_stderr: bool) {
+    let home = tempfile::tempdir().unwrap();
+    let agent = ureq::AgentBuilder::new().timeout(LIMIT).build();
+    let (mut daemon, url) = start(home.path(), Stdio::null());
+    wait_ready(&mut daemon, &agent, &url);
+    agent
+        .post(&format!("{url}/api/jellies"))
+        .send_json(json!({
+            "name": "old", "project": "test", "view": "<p>counter</p>",
+            "verbs": "const verbs = {increment(s) { s.count += 1; }};",
+            "state": {"count": 0}, "by": "test"
+        }))
+        .unwrap();
+    drop(daemon);
+
+    let path = home.path().join("jellies/test:old.json");
+    let mut saved: Value = serde_json::from_slice(&std::fs::read(&path).unwrap()).unwrap();
+    saved["jelly"]["updated_ms"] = json!(0);
+    std::fs::write(&path, serde_json::to_vec(&saved).unwrap()).unwrap();
+    // Force the archive's atomic write to fail without breaking store startup.
+    let blocked = path.with_extension("json.tmp");
+    std::fs::create_dir(&blocked).unwrap();
+
+    let warnings = home.path().join("stderr.txt");
+    let stderr = if closed_stderr {
+        let (reader, writer) = std::io::pipe().unwrap();
+        drop(reader);
+        writer.into()
+    } else {
+        std::fs::File::create(&warnings).unwrap().into()
+    };
+    let (mut daemon, url) = start(home.path(), stderr);
+    wait_ready(&mut daemon, &agent, &url);
+
+    // Keep exercising the lock while the startup sweep runs. Writable stderr also
+    // lets us observe its failure directly.
+    let deadline = Instant::now()
+        + if closed_stderr {
+            Duration::from_secs(1)
+        } else {
+            LIMIT
+        };
+    loop {
+        let listed: Value = agent
+            .get(&format!("{url}/api/jellies"))
+            .call()
+            .unwrap()
+            .into_json()
+            .unwrap();
+        let old = listed
+            .as_array()
+            .unwrap()
+            .iter()
+            .find(|j| j["name"] == "test:old")
+            .unwrap();
+        assert_eq!(old["archived"], false);
+        assert!(daemon.0.try_wait().unwrap().is_none(), "daemon exited");
+        if !closed_stderr
+            && std::fs::read_to_string(&warnings)
+                .unwrap()
+                .contains("could not archive test:old: ")
+        {
+            break;
+        }
+        if Instant::now() >= deadline {
+            assert!(closed_stderr, "archive failure did not warn");
+            break;
+        }
+        std::thread::sleep(Duration::from_millis(20));
+    }
+
+    // Allow the verb to persist successfully after the failed archive.
+    std::fs::remove_dir(blocked).unwrap();
+    let event: Value = agent
+        .post(&format!("{url}/api/jellies/test:old/call"))
+        .send_json(json!({"verb": "increment", "args": {}, "by": "test"}))
+        .unwrap()
+        .into_json()
+        .unwrap();
+    assert_eq!(event["state"], json!({"count": 1}));
+    agent.get(&format!("{url}/api/jellies")).call().unwrap();
+    assert!(daemon.0.try_wait().unwrap().is_none(), "daemon exited");
+    if !closed_stderr {
+        assert!(std::fs::read_to_string(warnings)
+            .unwrap()
+            .contains("could not archive test:old: "));
+    }
+}
+
+#[test]
+fn archive_failure_with_closed_stderr_keeps_store_usable() {
+    sweep_failure(true);
+}
+
+#[test]
+fn archive_failure_with_writable_stderr_still_warns() {
+    sweep_failure(false);
+}
