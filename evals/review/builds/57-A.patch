diff --git a/tests/sweep.rs b/tests/sweep.rs
new file mode 100644
index 0000000..75e9070
--- /dev/null
+++ b/tests/sweep.rs
@@ -0,0 +1,116 @@
+use serde_json::{json, Value};
+use std::net::TcpListener;
+use std::path::Path;
+use std::process::{Child, Command, Stdio};
+use std::time::{Duration, Instant};
+
+const LIMIT: Duration = Duration::from_secs(10);
+
+struct Daemon(Child);
+
+impl Drop for Daemon {
+    fn drop(&mut self) {
+        let _ = self.0.kill();
+        let _ = self.0.wait();
+    }
+}
+
+/// Starts a daemon on a free port and waits until it answers.
+fn start(home: &Path, stderr: Stdio) -> (Daemon, String) {
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let port = listener.local_addr().unwrap().port();
+    drop(listener);
+    let mut daemon = Daemon(
+        Command::new(env!("CARGO_BIN_EXE_jelly"))
+            .args(["serve", "--port", &port.to_string(), "--home"])
+            .arg(home)
+            .stdout(Stdio::null())
+            .stderr(stderr)
+            .spawn()
+            .unwrap(),
+    );
+    let url = format!("http://127.0.0.1:{port}");
+    let deadline = Instant::now() + LIMIT;
+    while ureq::get(&format!("{url}/api/jellies")).call().is_err() {
+        assert!(daemon.0.try_wait().unwrap().is_none(), "daemon exited during startup");
+        assert!(Instant::now() < deadline, "daemon did not start");
+        std::thread::sleep(Duration::from_millis(20));
+    }
+    (daemon, url)
+}
+
+fn sweep_failure(closed_stderr: bool) {
+    let home = tempfile::tempdir().unwrap();
+    let agent = ureq::AgentBuilder::new().timeout(LIMIT).build();
+    let counter = |name: &str| {
+        json!({
+            "name": name, "project": "test", "view": "<p>counter</p>",
+            "verbs": "const verbs = {increment(s) { s.count += 1; }};",
+            "state": {"count": 0}, "by": "test"
+        })
+    };
+    {
+        let (_daemon, url) = start(home.path(), Stdio::null());
+        for name in ["old", "counter"] {
+            agent.post(&format!("{url}/api/jellies")).send_json(counter(name)).unwrap();
+        }
+    }
+
+    // Make test:old stale so the startup sweep archives it, and make that archive
+    // fail: write_atomic cannot write its temp file over a directory.
+    let saved = home.path().join("jellies/test:old.json");
+    let mut old: Value = serde_json::from_slice(&std::fs::read(&saved).unwrap()).unwrap();
+    old["jelly"]["updated_ms"] = json!(0);
+    std::fs::write(&saved, serde_json::to_vec(&old).unwrap()).unwrap();
+    std::fs::create_dir(saved.with_extension("json.tmp")).unwrap();
+
+    let warnings = home.path().join("stderr.txt");
+    let stderr = if closed_stderr {
+        let (reader, writer) = std::io::pipe().unwrap();
+        drop(reader);
+        writer.into()
+    } else {
+        std::fs::File::create(&warnings).unwrap().into()
+    };
+    let (mut daemon, url) = start(home.path(), stderr);
+
+    // The sweep runs once at startup and leaves no trace on success, so in the
+    // closed case keep locking the store for a while after it must have run.
+    let deadline = Instant::now() + Duration::from_secs(1);
+    let mut listed: Value;
+    loop {
+        listed = agent.get(&format!("{url}/api/jellies")).call().unwrap().into_json().unwrap();
+        let swept = closed_stderr
+            || std::fs::read_to_string(&warnings).unwrap().contains("could not archive test:old");
+        if swept && Instant::now() >= deadline {
+            break;
+        }
+        assert!(Instant::now() < deadline + LIMIT, "sweep did not warn");
+        std::thread::sleep(Duration::from_millis(50));
+    }
+    let old = listed.as_array().unwrap().iter().find(|j| j["name"] == "test:old").unwrap();
+    assert_eq!(old["archived"], false);
+
+    let event: Value = agent
+        .post(&format!("{url}/api/jellies/test:counter/call"))
+        .send_json(json!({"verb": "increment", "args": {}, "by": "test"}))
+        .unwrap()
+        .into_json()
+        .unwrap();
+    assert_eq!(event["state"], json!({"count": 1}));
+    agent.get(&format!("{url}/api/jellies")).call().unwrap();
+    assert!(daemon.0.try_wait().unwrap().is_none());
+    if !closed_stderr {
+        assert!(std::fs::read_to_string(warnings).unwrap().contains("could not archive test:old: "));
+    }
+}
+
+#[test]
+fn archive_failure_with_closed_stderr_keeps_store_usable() {
+    sweep_failure(true);
+}
+
+#[test]
+fn archive_failure_with_writable_stderr_still_warns() {
+    sweep_failure(false);
+}
