@@ -0,0 +1,62 @@
+// Esc that cancels comment mode must not also reach the view (here: the map's trace).
+// Needs the fixture `escape:map`, see tests/README.md.
+async page => {
+  const base = new URL(page.url()).origin;
+  const name = 'escape:map';
+  const assert = (ok, message) => { if (!ok) throw Error(message); };
+  const step = async (root, n) => root.locator('.crumbs .chip').filter({hasText: `Step ${n} of`}).waitFor({timeout: 3000});
+  const noTrace = async root => root.locator('.crumbs .x[data-close]').waitFor({state: 'detached', timeout: 3000});
+  const advance = async root => {
+    await root.locator('#t-click').click();
+    await step(root, 1);
+    await root.locator('[data-step="1"]').click();
+    await root.locator('[data-step="1"]').click();
+    await step(root, 3);
+  };
+  const blur = () => page.evaluate(() => document.activeElement?.blur());
+
+  // Standalone.
+  await page.goto(`${base}/j/${name}/`);
+  await page.waitForFunction(() => window.jelly && document.querySelector('#t-click'));
+  await advance(page);
+  const comment = page.locator('.jf-btn');
+  await comment.click();
+  await page.waitForFunction(() => document.querySelector('.jf-btn').textContent.includes('Esc'));
+  await blur();
+  await page.keyboard.press('Escape');
+  await page.waitForFunction(() => document.querySelector('.jf-btn').textContent === 'Comment');
+  await step(page, 3);
+  await page.keyboard.press('Escape');
+  await noTrace(page);
+
+  // Comment editor: Esc in the textarea closes it and leaves the trace alone.
+  await advance(page);
+  await comment.click();
+  await page.locator('.crumbs').click();
+  await page.locator('.jf-pop textarea').waitFor();
+  await page.keyboard.press('Escape');
+  await page.locator('.jf-pop').waitFor({state: 'detached'});
+  await step(page, 3);
+
+  // Embedded in the jelly page's full view.
+  await page.goto(`${base}/p/escape`);
+  await page.waitForFunction(() => window.jelly && document.querySelector(".entry"));
+  await page.waitForFunction(() => pendingFocusWrites === 0);
+  const response = await page.request.post(`${base}/api/jellies/surface/call`, {data: {verb: 'focus', args: {name}, by: 'test'}});
+  assert(response.ok(), await response.text());
+  await page.locator('#full').waitFor({state: 'visible'});
+  await page.waitForFunction(name => document.querySelector('#full iframe')?.contentWindow.jelly?.name === name, name);
+  const frame = page.frameLocator('#full iframe');
+  await advance(frame);
+  await page.locator('#fcomment').click();
+  // The parent flips its button at once; wait until the frame has really entered comment mode.
+  await frame.locator('.crumbs').hover();
+  await frame.locator('.jf-hover').first().waitFor({state: 'attached'});
+  await page.keyboard.press('Escape');
+  await page.waitForFunction(() => !document.querySelector('#fcomment').classList.contains('on'));
+  assert(await page.locator('#full').isVisible(), 'Esc that cancels commenting keeps the full view open');
+  await step(frame, 3);
+  await page.keyboard.press('Escape');
+  await noTrace(frame);
+  return {passed: true};
+}
